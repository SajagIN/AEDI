NVIDIA_API_KEY=nvapi-your_key_here
# Optional additional keys for the KeyPool to round-robin across.
#
# IMPORTANT (see ENGINEERING_DECISIONS.md): NVIDIA NIM's daily token cap
# is per ACCOUNT, not per key. Generating NVIDIA_API_KEY_2, _3, etc. from
# the SAME NVIDIA account does NOT give you more daily quota - they all
# share the one 200k-tokens/day pool that account has. Confirmed directly
# from the API's own error messages: multiple keys from one account show
# the identical `organization` ID when rate-limited.
#
# Extra headroom only comes from keys generated on genuinely SEPARATE
# NVIDIA accounts (different email signups, never linked to each other).
# Multiple keys from one account still help spread PER-MINUTE rate limits
# across calls - just not the daily cap.
# NVIDIA_API_KEY_2=nvapi-...
# NVIDIA_API_KEY_3=nvapi-...

# Optional. Caps the max_tokens the agent asks for on each completion.
# Only needed if your tier's OUTPUT tokens-per-minute ceiling is low enough
# that a single request is rejected outright (a 429 mentioning OTPM or
# "reduce max_tokens"). The pipeline discovers this on its own and adapts;
# setting it here just skips the discovery round-trip. Floor is 256.
# AEDI_MAX_OUTPUT_TOKENS=1000

# Which NVIDIA NIM model the agent uses. The default is qwen/qwen3.6-27b. Override
# it if your account's free-tier limits on that model are too tight to run
# interactively — a model with a higher output-tokens-per-minute allowance
# will finish a live demo where the default one stalls.
# AEDI_MODEL=llama-3.3-70b-versatile

# How long the web console waits for the model on one live case before giving
# up and returning a readable error (seconds, default 90). Only affects the
# console; the batch runner in code/main.py is deliberately more patient.
# AEDI_LIVE_TIMEOUT=90

# Reasoning effort for the agent's calls. The default model is a reasoning
# model, and on NVIDIA NIM the output-token budget is spent on thinking AND on
# answering — so on an account with a low output ceiling the model can burn the
# whole budget thinking and return nothing (a 400 tool_use_failed with an empty
# failed_generation). The pipeline detects that and switches reasoning off by
# itself. Set this to pin the behaviour either way. NVIDIA NIM's qwen3 models accept
# only "none" or "default"; anything else is a 400.
# AEDI_REASONING_EFFORT=none

# ── Razorpay (optional) ───────────────────────────────────────────────────
# Powers the console's "Live · Razorpay" tab: create a real test-mode order,
# take a real test payment, then run the pipeline over the resulting dispute.
#
# TEST KEYS ONLY. A key beginning rzp_live_ is refused at startup — the
# console can submit dispute responses, and accepting a dispute is
# irreversible and moves real money.
#
# Dashboard -> (toggle to Test) -> Settings -> API Keys.
# RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# RAZORPAY_KEY_SECRET=your_key_here

# Optional. Set this and point a Razorpay webhook at POST /api/rzp/webhook to
# receive genuine payment.dispute.created events. Unsigned requests are
# dropped. This is the only path by which a real dispute can reach the
# console — Razorpay has no dispute-create API.
# RAZORPAY_WEBHOOK_SECRET=your_key_here

# Development only: point the client at a local stand-in instead of Razorpay.
# See scripts/razorpay_mock.py.
# RAZORPAY_API_BASE=http://127.0.0.1:9911

# ── Merchant adverse-media intel (optional) ───────────────────────────────
# Powers the "Merchant intel" panel in the console: searches the open web for
# consumer complaints about a named business, as a LEADING indicator of
# merchant risk. Your own chargeback data only names a bad merchant after
# ninety days of damage; complaints show up weeks earlier.
#
# Entirely optional. Without it the panel says so and everything else works.
# The signal can only ever route a case to a human reviewer — it can never
# clear one, decide one, or label a business. Free tier at https://serpapi.com
SERPAPI_KEY=

# Optional. Several NIM models reason before answering, and on those the
# output budget pays for the thinking AND the answer out of one allowance.
# This pipeline's last round is a forced call to one named function with a
# fixed schema, so there is no essay to write — thinking is off by default and
# the whole budget goes to the tool call.
#
# Turn it back on only if you want it, and give it room when you do:
# AEDI_ENABLE_THINKING=1
# AEDI_MAX_OUTPUT_TOKENS=16384
#
# Optional. Any model in the catalogue that supports function calling.
# scripts/nim_doctor.py verifies a candidate in five probes before you commit
# a whole run to it.
# AEDI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
