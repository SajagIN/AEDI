GROQ_API_KEY=gsk_your_key_here
# Optional additional keys for the KeyPool to round-robin across.
#
# IMPORTANT (see ENGINEERING_DECISIONS.md): Groq's daily token cap
# is per ACCOUNT, not per key. Generating GROQ_API_KEY_2, _3, etc. from
# the SAME Groq account does NOT give you more daily quota - they all
# share the one 200k-tokens/day pool that account has. Confirmed directly
# from the API's own error messages: multiple keys from one account show
# the identical `organization` ID when rate-limited.
#
# Extra headroom only comes from keys generated on genuinely SEPARATE
# Groq accounts (different email signups, never linked to each other).
# Multiple keys from one account still help spread PER-MINUTE rate limits
# across calls - just not the daily cap.
# GROQ_API_KEY_2=gsk_...
# GROQ_API_KEY_3=gsk_...

# Optional. Caps the max_tokens the agent asks for on each completion.
# Only needed if your tier's OUTPUT tokens-per-minute ceiling is low enough
# that a single request is rejected outright (a 429 mentioning OTPM or
# "reduce max_tokens"). The pipeline discovers this on its own and adapts;
# setting it here just skips the discovery round-trip. Floor is 256.
# AEDI_MAX_OUTPUT_TOKENS=1000

# ── Razorpay (optional) ───────────────────────────────────────────────────
# Powers the console's "Live · Razorpay" tab: create a real test-mode order,
# take a real test payment, then run the pipeline over the resulting dispute.
#
# TEST KEYS ONLY. A key beginning rzp_live_ is refused at startup — the
# console can submit dispute responses, and accepting a dispute is
# irreversible and moves real money.
#
# Dashboard -> (toggle to Test) -> Settings -> API Keys.
# RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# RAZORPAY_KEY_SECRET=your_key_here

# Optional. Set this and point a Razorpay webhook at POST /api/rzp/webhook to
# receive genuine payment.dispute.created events. Unsigned requests are
# dropped. This is the only path by which a real dispute can reach the
# console — Razorpay has no dispute-create API.
# RAZORPAY_WEBHOOK_SECRET=your_key_here

# Development only: point the client at a local stand-in instead of Razorpay.
# See scripts/razorpay_mock.py.
# RAZORPAY_API_BASE=http://127.0.0.1:9911
